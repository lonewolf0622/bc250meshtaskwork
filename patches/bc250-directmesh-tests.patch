+autocull_small32pp|cmp|-DLANES=32 -DVERTS=32 -DPRIMS=32 -DPERPRIM=1 -DNOCULL=1|-|1||RADV_BC250_MESH_AUTOCULL=1|0|MESH COMPACT: applied;autocull=1;owned=0x1
