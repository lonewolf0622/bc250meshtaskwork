+drfull_small32pp|cmp|-DLANES=32 -DVERTS=32 -DPRIMS=32 -DPERPRIM=1 -DNOCULL=1|-|1|RADV_BC250_MESH_DIRECT_READ=full||0|MESH COMPACT: applied;direct=1;owned=0x1
