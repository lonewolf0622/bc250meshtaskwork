+  (out/'binding-summary.json').write_text(json.dumps(rows,indent=2)+'\n');print(mode,shape,'PASS',flush=True)
+print('Binding proof PASS',len(rows),'routes',sum(r['cpu_cases'] for r in rows),'CPU cases')
