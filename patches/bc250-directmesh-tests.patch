+cc -Wall -Wextra -O2 -g -I"$mesa_root/include" "$source_dir/mesh_smoke.c" -l:libvulkan.so.1 -o mesh-smoke
+compile() {
+  glslangValidator -V --target-env vulkan1.3 "$@"
+  local output=${!#}
