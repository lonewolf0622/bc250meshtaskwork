+  uint draw=payload.draw;
+  position=position/8.0+vec2(float(draw%8u)+0.5,float(draw/8u)+0.5)/4.0-1.0;
+#endif
+  gl_MeshVerticesEXT[i].gl_Position=vec4(position,0,1);
+#if TASK
+#if DB
+  if(payload.marker!=31u+payload.draw || heap_data.words[0]+root.value+constants.value!=31u)
+#else
+  if(payload.marker!=1u+payload.draw)
+#endif
