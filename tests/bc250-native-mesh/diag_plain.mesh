#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=1) in;
layout(triangles,max_vertices=3,max_primitives=1) out;
void main() {
    SetMeshOutputsEXT(3,1);
    vec2 p[3]=vec2[3](vec2(-0.7,-0.7),vec2(0.7,-0.7),vec2(0,0.7));
    gl_MeshVerticesEXT[gl_LocalInvocationIndex].gl_Position=vec4(p[gl_LocalInvocationIndex],0,1);
    if(gl_LocalInvocationIndex==0) gl_PrimitiveTriangleIndicesEXT[0]=uvec3(0,1,2);
}
