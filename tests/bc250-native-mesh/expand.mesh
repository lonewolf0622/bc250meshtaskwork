#version 460
#extension GL_EXT_mesh_shader : require
#ifndef OUTPUT_VERTICES
#define OUTPUT_VERTICES 256
#endif
#ifndef LOCAL_SIZE
#define LOCAL_SIZE 32
#endif
#ifndef SPARSE
#define SPARSE 0
#endif
#ifndef REFERENCE
#define REFERENCE 0
#endif
#ifndef MAX_PRIMITIVES
#define MAX_PRIMITIVES 2
#endif
#ifndef GROUPS
#define GROUPS 1
#endif
layout(local_size_x=LOCAL_SIZE) in;
layout(triangles,max_vertices=SPARSE!=0?OUTPUT_VERTICES:6,max_primitives=MAX_PRIMITIVES) out;
#if REFERENCE
layout(location=0) flat out vec3 color[];
#else
layout(location=0) perprimitiveEXT out vec3 color[];
#endif
void main() {
    SetMeshOutputsEXT(SPARSE!=0?OUTPUT_VERTICES:(REFERENCE!=0?6:4), 2);
    uint lane=gl_LocalInvocationIndex;
    uint group=gl_WorkGroupID.x;
    vec2 p[4]=vec2[4](vec2(-0.7,-0.7),vec2(0.7,-0.7),vec2(0.7,0.7),vec2(-0.7,0.7));
    uint map[6]=uint[6](0,1,2,0,2,3);
    uint base=SPARSE!=0?OUTPUT_VERTICES-6:0;
    // All stores follow SetMeshOutputsEXT, including unused output stores.
    if (SPARSE!=0) {
        for(uint i=lane;i<base;i+=LOCAL_SIZE) {
            gl_MeshVerticesEXT[i].gl_Position=vec4(4,4,0,1);
#if REFERENCE
            color[i]=vec3(0);
#endif
        }
    }
    for(uint i=lane;i<(REFERENCE!=0?6:4);i+=LOCAL_SIZE) {
        vec2 pos=p[REFERENCE!=0?map[i]:i];
        if(GROUPS==2) pos.x=pos.x*0.5+(group==0?-0.48:0.48);
        gl_MeshVerticesEXT[base+i].gl_Position=vec4(pos,0,1);
#if REFERENCE
        color[base+i]=i<3?vec3(1,0,0):vec3(0,1,0);
#endif
    }
    if(lane<2) {
        gl_PrimitiveTriangleIndicesEXT[lane]=REFERENCE!=0?uvec3(base+lane*3,base+lane*3+1,base+lane*3+2):
            (lane==0?uvec3(base,base+1,base+2):uvec3(base,base+2,base+3));
#if !REFERENCE
        color[lane]=lane==0?vec3(1,0,0):vec3(0,1,0);
#endif
    }
}
