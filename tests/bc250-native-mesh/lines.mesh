#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
layout(lines,max_vertices=4,max_primitives=2) out;
layout(location=0) perprimitiveEXT out vec3 color[];
void main() {
    SetMeshOutputsEXT(4, 2);
    uint lane=gl_LocalInvocationIndex;
    // Two horizontal segments: red at NDC y=-0.5, green at y=+0.5. Exercises
    // the corners=2 expansion epilogue path (uvec2 index rewrite).
    vec2 pos[4]=vec2[4](vec2(-0.7,-0.5),vec2(0.7,-0.5),vec2(-0.7,0.5),vec2(0.7,0.5));
    for(uint i=lane;i<4;i+=32) gl_MeshVerticesEXT[i].gl_Position=vec4(pos[i],0,1);
    if(lane<2) {
        gl_PrimitiveLineIndicesEXT[lane]=uvec2(2*lane,2*lane+1);
        color[lane]=lane==0?vec3(1,0,0):vec3(0,1,0);
    }
}
