#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
layout(triangles,max_vertices=3,max_primitives=1) out;
struct Payload { uvec3 id; uvec3 size; uint draw; uint sentinel; };
taskPayloadSharedEXT Payload p;
layout(set=0,binding=0,std430) buffer Visited { uint visits[]; };
void main() {
    SetMeshOutputsEXT(0,0);
    if(gl_LocalInvocationIndex==0) {
        uvec3 expected=uvec3(1); expected[AXIS]=4097; expected[(AXIS+1)%3]=2;
        bool ok=all(equal(p.size,expected)) && all(lessThan(p.id,expected)) &&
            p.draw==0 && gl_DrawID==0 && p.sentinel==0x12345678u &&
            all(equal(gl_NumWorkGroups,uvec3(2,1,1)));
        uint idx=p.id.x+expected.x*(p.id.y+expected.y*p.id.z);
        if(ok && idx<8194) atomicAdd(visits[idx],1);
        else atomicAdd(visits[8194],1);
    }
}
