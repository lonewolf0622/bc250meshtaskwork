#version 460
#extension GL_EXT_mesh_shader : require
#ifndef LOCAL_X
#define LOCAL_X 1
#define LOCAL_Y 1
#define LOCAL_Z 1
#endif
layout(local_size_x=LOCAL_X,local_size_y=LOCAL_Y,local_size_z=LOCAL_Z) in;
layout(triangles,max_vertices=3,max_primitives=1) out;
void main() {
   /* One triangle per mesh invocation. */
   SetMeshOutputsEXT(3,1);
   if (gl_LocalInvocationIndex != 0) return;
   gl_MeshVerticesEXT[0].gl_Position = vec4(-1.0,-1.0,0.0,1.0);
   gl_MeshVerticesEXT[1].gl_Position = vec4( 1.0,-1.0,0.0,1.0);
   gl_MeshVerticesEXT[2].gl_Position = vec4( 0.0, 1.0,0.0,1.0);
   gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0,1,2);
}
