#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
layout(triangles,max_vertices=4,max_primitives=2) out;
layout(location=0) perprimitiveEXT out vec3 color[];
void main() {
    SetMeshOutputsEXT(4, 2);
    uint lane=gl_LocalInvocationIndex;
    // Two triangles (a quad split), one per primitive. Primitive 0 routes to
    // layer 0 red, primitive 1 to layer 3 green; layers 1-2 must stay black.
    vec2 p[4]=vec2[4](vec2(-0.7,-0.7),vec2(0.7,-0.7),vec2(0.7,0.7),vec2(-0.7,0.7));
    for(uint i=lane;i<4;i+=32) gl_MeshVerticesEXT[i].gl_Position=vec4(p[i],0,1);
    if(lane<2) {
        gl_PrimitiveTriangleIndicesEXT[lane]=(lane==0?uvec3(0,1,2):uvec3(0,2,3));
        color[lane]=lane==0?vec3(1,0,0):vec3(0,1,0);
        gl_MeshPrimitivesEXT[lane].gl_Layer=lane==0?0:3;
    }
}
