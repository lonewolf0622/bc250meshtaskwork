#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 128) in;
layout(max_vertices = 256, max_primitives = 128, triangles) out;
layout(location = 0) out vec4 v0[];
layout(location = 1) out vec4 v1[];
layout(location = 2) out vec4 v2[];
layout(location = 3) out vec4 v3[];
layout(location = 4) out vec4 v4[];
layout(location = 5) out vec4 v5[];
layout(location = 6) perprimitiveEXT out uvec4 pp[];
void main() {
   SetMeshOutputsEXT(256, 128);
   for (uint i = gl_LocalInvocationIndex; i < 256; i += 128) {
      gl_MeshVerticesEXT[i].gl_Position = vec4(float(i), 0.0, 0.0, 1.0);
      v0[i] = vec4(float(i + 0));
      v1[i] = vec4(float(i + 1));
      v2[i] = vec4(float(i + 2));
      v3[i] = vec4(float(i + 3));
      v4[i] = vec4(float(i + 4));
      v5[i] = vec4(float(i + 5));
   }
   uint t = gl_LocalInvocationIndex;
   gl_PrimitiveTriangleIndicesEXT[t] = uvec3(t, t + 1, t + 2);
   pp[t] = uvec4(t);
}
