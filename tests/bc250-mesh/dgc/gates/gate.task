#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=32) in;
#if DB
layout(set=0,binding=0,std430) readonly buffer Resource { uint words[]; } heap_data;
layout(set=1,binding=0,std140) uniform Root { uint value; } root;
layout(push_constant) uniform Constants { uint value; } constants;
#endif
struct Payload { uint marker; uint draw; };
taskPayloadSharedEXT Payload payload;
void main() {
 if(gl_LocalInvocationIndex==0) {
  payload.draw=gl_DrawID;
#if DB
  payload.marker=heap_data.words[0]+root.value+constants.value+gl_DrawID;
#else
  payload.marker=1u+gl_DrawID;
#endif
 }
 EmitMeshTasksEXT(1,1,1);
}
