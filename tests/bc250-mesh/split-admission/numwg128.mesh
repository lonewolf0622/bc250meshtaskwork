#version 460
#extension GL_EXT_mesh_shader : require
// tri128_numwg without the SSBO store: NumWorkGroups reaches the outputs.
layout(local_size_x=128) in;
layout(triangles, max_vertices=128, max_primitives=128) out;
layout(location=0) perprimitiveEXT flat out vec4 pcol[];

void main(){
 uint i=gl_LocalInvocationIndex;
 SetMeshOutputsEXT(128,128);
 gl_MeshVerticesEXT[i].gl_Position=vec4(float(i%16u)/8.0-1.0,float(i/16u)/8.0-1.0,0.5,1);
 gl_PrimitiveTriangleIndicesEXT[i]=uvec3(i,(i+1u)%128u,(i+2u)%128u);
 pcol[i]=vec4(float(gl_NumWorkGroups.x)/255.0,float(gl_NumWorkGroups.y),float(gl_NumWorkGroups.z),float(gl_WorkGroupID.x));
}
