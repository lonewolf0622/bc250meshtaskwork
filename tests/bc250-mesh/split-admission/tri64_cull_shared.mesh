#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=64) in;
layout(triangles, max_vertices=64, max_primitives=64) out;
layout(location=0) perprimitiveEXT flat out vec4 pcol[];
layout(set=0,binding=0,std430) buffer S { uint count; uint data[]; } s;
shared uint sh[64];

void main(){
 uint i=gl_LocalInvocationIndex;
 SetMeshOutputsEXT(64,64);
 for(uint v=i; v<64; v+=64) gl_MeshVerticesEXT[v].gl_Position=vec4(float(v%16)/8.0-1.0,float(v/16)/8.0-1.0,0.5,1);
 for(uint p=i; p<64; p+=64) {
   gl_PrimitiveTriangleIndicesEXT[p]=uvec3(p%64,(p+1)%64,(p+2)%64);
   
   
   pcol[p]=vec4(float(p)/255.0,0,1,1);
 }
 sh[i]=i; barrier(); if(sh[(i+1u)%64u]==0xffffffffu) s.count=1u; for(uint p=i;p<64u;p+=64u) gl_MeshPrimitivesEXT[p].gl_CullPrimitiveEXT=(p%2u)==1u;
}
