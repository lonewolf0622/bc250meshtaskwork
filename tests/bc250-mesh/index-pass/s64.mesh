#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x=64) in;
layout(triangles,max_vertices=64,max_primitives=64) out;
layout(location=1) out vec4 vtx[];
void main(){
 uint w=gl_WorkGroupID.x;
 SetMeshOutputsEXT(64,64);
 vec2 tile=vec2(float(w&7u),float(w>>3))/4.0-1.0;
 uint i=gl_LocalInvocationIndex;
 vec2 g=vec2(float(i&7u),float(i>>3))/8.0;
 gl_MeshVerticesEXT[i].gl_Position=vec4(tile+g*0.25+vec2(0.01),0.5,1.0);
 vtx[i]=vec4(float(i)/64.0,float(w)/64.0,0.75,1.0);
 uint a,b2,c;
 uint s=min(i,61u); a=s; b2=s+1u+((i+w)%2u); c=(i>=24u && (i%4u)==0u) ? s-20u : s+2u; if(i>=61u){a=61u+(i-61u)%3u; b2=60u; c=63u;}
 gl_PrimitiveTriangleIndicesEXT[i]=uvec3(a,b2,c);
}
